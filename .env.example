# Cliente (Vite) — prioridad sobre Centro de Conexión en la UI
# Ejemplo Tailscale: http://100.x.x.x:5174
VITE_API_URL=
VITE_WS_URL=

# Servidor (server/index.js)
TMDB_API_KEY=
OMDB_API_KEY=

# Importación Trakt (solo Client ID para listas públicas)
TRAKT_CLIENT_ID=

# Puerto del frontend (solo informativo en /api/network/info)
FRONTEND_PORT=5173

# Deploy remoto (scripts/deploy-ssh.sh)
ANIMDB_SSH_HOST=
ANIMDB_SSH_PATH=~/animdb
